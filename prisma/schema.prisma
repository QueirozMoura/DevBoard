generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique // sempre em minúsculas (CHECK na migration)
  name         String   @db.VarChar(100)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignedTasks Task[] @relation("Assignee")
  createdTasks Task[] @relation("Creator")
  comments Comment[]
  activities Activity[]
  memberships ProjectMember[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") // apenas o hash; o token em si nunca é salvo
  familyId     String    @map("family_id") @db.Uuid // agrupa tokens de uma mesma sessão (rotação/reuso)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum ProjectRole {
  OWNER
  MEMBER
}

model Project {
  id String @id @default(uuid(7)) @db.Uuid
  name String @db.VarChar(100)
  description String? @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  activities Activity[]
  tasks Task[]
  members ProjectMember[]
  @@map("projects")
}

model ProjectMember {
  projectId String @db.Uuid
  userId String @db.Uuid
  role ProjectRole @default(MEMBER)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum TaskStatus {
 TODO
 IN_PROGRESS
 IN_REVIEW
 DONE
}
enum TaskPriority {
 LOW
 MEDIUM
 HIGH
 URGENT
}
model Task {
 id String @id @default(uuid(7)) @db.Uuid
 projectId String @db.Uuid
 title String @db.VarChar(200)
 description String? @db.VarChar(10000)
 status TaskStatus @default(TODO)
 priority TaskPriority @default(MEDIUM)
 assigneeId String? @db.Uuid
 createdById String? @db.Uuid
 dueDate DateTime? @db.Timestamptz(3)
 position String @db.VarChar(32)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 activities Activity[]
 comments Comment[]
 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 assignee User? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
 createdBy User? @relation("Creator", fields: [createdById], references: [id], onDelete: SetNull)
 @@index([projectId, status, position, id])
 @@index([assigneeId])
 @@map("tasks")
}

model Comment {
 id String @id @default(uuid(7)) @db.Uuid
 taskId String @db.Uuid
 authorId String? @db.Uuid
 body String @db.VarChar(5000)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
 author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
 @@index([taskId, createdAt, id])
 @@map("comments")
}

enum ActivityType {
 PROJECT_CREATED
 PROJECT_UPDATED
 MEMBER_ADDED
 MEMBER_REMOVED
 MEMBER_ROLE_CHANGED
 TASK_CREATED
 TASK_UPDATED
 TASK_MOVED
 TASK_DELETED
 COMMENT_ADDED
}
model Activity {
 id String @id @default(uuid(7)) @db.Uuid
 projectId String @db.Uuid
 taskId String? @db.Uuid
 actorId String? @db.Uuid
 type ActivityType
 data Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
 actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
 @@index([projectId, createdAt, id])
 @@index([taskId])
 @@map("activities")
}
