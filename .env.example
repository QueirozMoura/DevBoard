# Copie para .env e ajuste. NUNCA versione o .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Credenciais do PostgreSQL local (usadas pelo compose.yaml). Troque a senha.
POSTGRES_USER=devboard
POSTGRES_PASSWORD=change-me

# Banco de desenvolvimento (porta 5432)
DATABASE_URL=postgresql://devboard:change-me@localhost:5432/devboard
# Banco de testes, isolado (porta 5433, banco devboard_test)
TEST_DATABASE_URL=postgresql://devboard:change-me@localhost:5433/devboard_test
